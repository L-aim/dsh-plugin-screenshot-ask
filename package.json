{
  "name": "dsh-plugin-screenshot-ask",
  "version": "0.2.10",
  "description": "DSH 插件：截图提问——框选屏幕任意区域，图片直接进入输入框，补一句问题即可发送",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "screen-capture",
    "region-select",
    "windows"
  ],
  "homepage": "https://github.com/L-aim/dsh-plugin-screenshot-ask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-aim/dsh-plugin-screenshot-ask.git"
  },
  "bugs": {
    "url": "https://github.com/L-aim/dsh-plugin-screenshot-ask/issues"
  },
  "author": "L-aim",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
